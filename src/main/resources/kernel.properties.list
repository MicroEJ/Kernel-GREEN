###############################################################################
# Logger
###############################################################################

# Defines standard logging levels to control output.
# Levels (highest to lowest): SEVERE, WARNING, INFO, CONFIG, FINE, FINER, FINEST.
# Special levels: ALL (log everything), OFF (disable logging).
.level=ALL

###############################################################################
# Security Manager
###############################################################################

security.manager.enabled=true

# Expected values: LOGGING (default) | POLICY_FILE
security.manager.mode=LOGGING

###############################################################################
# Resource Manager
###############################################################################

# Feature policy file
feature.policy.name=/feature.policy.json

###############################################################################
# Connectivity Manager
###############################################################################

# Initial delay in milliseconds before starting the connectivity checker task.
connectivity.task.delay=0

# Interval in milliseconds for periodic connectivity checks.
connectivity.task.period=1000

# URL used to verify internet connectivity by establishing a connection.
# Replace with a custom URL in production for better reliability and control.
connectivity.http.host=microej.com

# Connectivity port (uncomment and configure as needed).
#connectivity.port=443

###############################################################################
# Network Time Protocol (NTP)
###############################################################################

# URL of the NTP server used for updating device time.
ntp.url=0.pool.ntp.org

# Port used by the NTP server.
ntp.port=123

# Timeout in milliseconds for NTP client time synchronization requests.
ntp.timeout=1000

###############################################################################
# Resource Monitoring
###############################################################################

monitoring.check.enabled=true

# Polling interval in milliseconds for monitoring resource consumption.
monitoring.check.interval.ms=10000

# If true, runs Garbage Collector before collecting RAM usage for refined monitoring.
# Not recommended for production.
monitoring.check.gc.force=false

# This value represents the mapping of CPU load to the MicroEJ execution counter per one second.
# It is generated during a calibration phase on the target device.
monitoring.check.cpu.calibration=590000

###############################################################################
# Storage
###############################################################################

# Implementation class of Storage Service
ej.storage.Storage=com.microej.kf.util.storage.SandboxedStorage

# Storage root directory
ej.storage.fs.StorageFs.root=storage


###############################################################################
# App Connect
###############################################################################

# Specifies App Connect HTTP Server Port
appconnect.http.port=4001

# Specifies max worker threads used to processes incoming HTTP Connections
appconnect.http.workers.max=2

# Specifies max allowed simultaneous HTTP Connections for App Connect HTTP Server
appconnect.http.connections.max=2

# Specifies the time to wait for the app to stop
appconnect.stop.timeout.ms=5000

# Specifies the size of buffer used to read app input steam
appconnect.install.buffer.size=512
