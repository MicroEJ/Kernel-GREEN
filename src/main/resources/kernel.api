	<!-- Set of fields and methods from ej.bon.XMath class to ensure compatibility despite being deprecated to java.lang.Math from EDC -->

	<type name="ej.bon.XMath"/>
	<field name="ej.bon.XMath.E"/>
	<field name="ej.bon.XMath.PI"/>
	<method name="ej.bon.XMath.abs(double)double"/>
